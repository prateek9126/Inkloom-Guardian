# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Standard PostgreSQL URI format: postgresql://[user[:password]@][netloc][:port][/dbname]
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inkloom_guardian

# Authentication Security
JWT_SECRET=inkloom_jwt_super_secure_enterprise_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# LLM / AI Engine Configuration
# Available Providers: 'gemini', 'openai', 'anthropic', 'mock'
# If no API key is provided, the platform automatically utilizes the built-in
# Enterprise Heuristic & Deterministic Rule Intelligence Engine.
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=default

# Upload Configuration
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=./uploads
